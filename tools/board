#!/usr/bin/env python3
"""corral 看板：在终端里实时列出所有 agent 的状态，选中一个让旁边一格显示它。

配套工具，不属于 corral 内核：只调用本仓库 bin/corral 的公开命令（ls、status、reply、attach、stop），
不读状态目录里的文件。

三种用法：
  tools/board            面板：状态表，下面是选中 agent 的上一轮回复。回车或鼠标点一行，让显示器接入它；
                         x 再按 y 关掉它；q 退出。
  tools/board --viewer   显示器：放在面板旁边一格。面板选了谁，它就在这一格里替你运行 corral attach；
                         换人时先断开当前的（被断开的 agent 继续跑）。按 Ctrl-] 断开后回到空闲画面，空闲时按 q 退出。
  tools/board --once     只打印一次状态表。

面板和显示器通过 board 自己的临时目录（$TMPDIR/corral-board-<uid>/）传话，和 corral 的状态目录无关。
"""
import argparse
import curses
import json
import locale
import os
import re
import select
import signal
import subprocess
import sys
import tempfile
import termios
import threading
import time
import tty
import unicodedata

CORRAL = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "bin", "corral")
COLUMNS = ("NAME", "KIND", "INST", "STATE", "DOING", "QUIET", "ATT", "SOURCE", "TITLE")
POLL = 0.05  # 面板和显示器互相看对方的间隔：点了 agent 后，右格和箭头要跟得上
KEYS = (("↑↓", "select"), ("enter/click", "show in viewer"), ("PgUp/PgDn", "scroll"), ("s", "sort"), ("x", "stop"), ("q", "quit"))
KEYS_SHORT = (("↑↓", "select"), ("enter", "show"), ("PgUp/Dn", "scroll"), ("s", "sort"), ("x", "stop"), ("q", "quit"))  # 不足 80 列时
SPIN = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"
WHEEL_UP, WHEEL_DOWN = curses.BUTTON4_PRESSED, getattr(curses, "BUTTON5_PRESSED", 0)  # 终端通用的鼠标上报里，滚轮是 4、5 号键
# 面板的列：键、表头、窄屏时藏掉的先后（0 = 一直显示）
PANEL_COLUMNS = (("name", "NAME", 0), ("kind", "KIND", 5), ("instance", "INST", 2), ("state", "STATE", 0),
                 ("doing", "DOING", 0), ("quiet", "QUIET", 6), ("attached", "ATT", 0), ("source", "SOURCE", 4),
                 ("dir", "DIR", 3), ("title", "TITLE", 1))
DIM_COLUMNS = ("kind", "instance", "source", "dir", "title")
LIST_MIN = 10          # 列表区最少占几行：不够就留白，不要被回复区挤掉，分隔线位置才稳定
MIN_WIDTHS = {"kind": 6, "instance": 6, "state": 10, "doing": 22}  # 取值范围固定或一直在变的列给够宽度，表格不跳
RIGHT_ALIGNED = ("quiet",)  # 数字右对齐，好比
STATE_RANK = {"blocked": 0, "working": 2, "starting": 3, "idle": 5}  # 按状态排时的先后；疑似卡住排 1


def corral(*args, timeout=15):
    try:
        proc = subprocess.run([sys.executable, CORRAL, *args], capture_output=True, text=True, timeout=timeout)
        return proc.returncode, json.loads(proc.stdout)
    except (subprocess.TimeoutExpired, ValueError):
        return -1, {}


def width(s):
    return sum(2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1 for ch in s)


def cut(s, n):
    out = ""
    for ch in s:
        if width(out + ch) > n:
            return out[:-1] + "…"
        out += ch
    return out


def pad(s, n):
    return s + " " * max(0, n - width(s))


def secs(x):
    return "" if x is None else (f"{int(x)}s" if x < 3600 else f"{x / 3600:.1f}h")


def collect(prefix):
    """每个 agent 一条：名字、状态、接入窗口数，和表格里的一行。"""
    code, listing = corral("ls")
    if code != 0:
        return [{"name": None, "state": None, "attached": 0, "st": {}, "instance": None, "cwd": None,
                 "starting": False,
                 "cells": ("(corral ls failed)", "", "", listing.get("error", ""), "", "", "", "", "")}]
    now = time.time()
    out = []
    for item in sorted(listing.get("agents", []), key=lambda i: i["name"]):
        name = item["name"]
        if prefix and not name.startswith(prefix):
            continue
        st = {}
        if item.get("starting"):
            cells = (name, "", "", "(starting)", "", "", "", "", "")
        elif item.get("incompatible"):
            cells = (name, "", "", f"(incompatible proto {item.get('proto')})", "", "", "", "", "")
        else:
            code, st = corral("status", name)
            if code != 0:
                cells, st = (name, item.get("kind") or "", "", f"(exit {code})", "", "", "", "", ""), {}
            else:
                doing = ""
                if st.get("state") in ("working", "blocked"):
                    elapsed = secs(now - st["turn_started"]) if st.get("turn_started") else ""
                    doing = f"{st.get('last_tool') or 'thinking'} {elapsed}".strip()
                cells = (name, st.get("kind") or "", (st.get("instance") or "")[:6], st.get("state") or "", doing,
                         secs(st.get("idle_for")), str(st.get("attached", "")), st.get("last_input_source") or "",
                         cut(st.get("title") or "", 28))
        out.append({"name": name, "state": st.get("state"), "attached": st.get("attached") or 0, "cells": cells,
                    "st": st, "instance": item.get("instance"), "cwd": item.get("cwd"),
                    "starting": bool(item.get("starting"))})
    return out


def col_widths(records):
    table = [COLUMNS] + [r["cells"] for r in records]
    return [max(width(r[i]) for r in table) for i in range(len(COLUMNS))]


def table_lines(records):
    widths = col_widths(records)
    table = [COLUMNS] + [r["cells"] for r in records]
    return ["  ".join(pad(c, w) for c, w in zip(r, widths)).rstrip() for r in table]


def render(prefix):
    records = collect(prefix)
    lines = [f"corral board  {time.strftime('%H:%M:%S')}"] + table_lines(records)
    if not records:
        lines.append("(no agents)")
    return "\n".join(lines)


# ---- 面板和显示器之间传话：board 自己临时目录里的两个小文件

def channel(name):
    d = os.path.join(tempfile.gettempdir(), f"corral-board-{os.getuid()}")
    os.makedirs(d, mode=0o700, exist_ok=True)
    return os.path.join(d, name)


def read_json(path):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def write_json(path, obj):
    tmp = f"{path}.{os.getpid()}"
    with open(tmp, "w") as f:
        json.dump(obj, f)
    os.replace(tmp, path)


def viewer_info():
    """在跑的显示器留下的 {"pid", "showing"}；没有显示器时返回 None。"""
    info = read_json(channel("viewer"))
    try:
        os.kill(info["pid"], 0)
    except (OSError, KeyError, TypeError):
        return None
    return info


# ---- 显示器

class Viewer:
    def __init__(self):
        self.target = channel("target")
        t = read_json(self.target)
        self.seen = t.get("seq") if isinstance(t, dict) else None  # 启动前留下的指令不执行
        self.note = ""
        self.resized = False

    def set_showing(self, name):
        write_json(channel("viewer"), {"pid": os.getpid(), "showing": name})

    def next_target(self):
        """面板写了新指令就返回要显示的名字，否则 None。"""
        t = read_json(self.target)
        if not isinstance(t, dict) or t.get("seq") == self.seen:
            return None
        self.seen = t.get("seq")
        return t.get("name")

    def draw_idle(self):
        """几段文字上下居中、左留 2 格：标题粗体，上一次的说明灰色，q 青色粗体。"""
        paras = ["\x1b[1mcorral viewer", "Not attached. Pick an agent in the panel: press enter or click it."]
        if self.note:
            paras.append("\x1b[90m" + self.note)
        paras.append("\x1b[1;36mq\x1b[0m quit")
        try:
            rows = os.get_terminal_size(sys.stdout.fileno()).lines
        except OSError:
            rows = 24
        top = max(0, (rows - (2 * len(paras) - 1)) // 2)
        sys.stdout.write("\x1b[H\x1b[2J" + "\n" * top + "\n\n".join(f"  {p}\x1b[0m" for p in paras))
        sys.stdout.flush()

    def idle(self):
        """画空闲画面，等面板的指令，返回要显示的名字；按 q 或终端关了返回 None。"""
        fd = sys.stdin.fileno()
        tty.setcbreak(fd)
        self.draw_idle()
        while True:
            if self.resized:
                self.resized = False
                self.draw_idle()
            r, _, _ = select.select([fd], [], [], POLL)
            if r:
                data = os.read(fd, 64)
                if not data or b"q" in data:
                    return None
            name = self.next_target()
            if name:
                return name

    def show(self, name):
        """在这一格里接入 name，直到断开、agent 退出或面板换人。换人时返回下一个名字，否则 None。"""
        self.set_showing(name)
        proc = subprocess.Popen([sys.executable, CORRAL, "attach", name], stderr=subprocess.DEVNULL)
        nxt = None
        while proc.poll() is None:
            time.sleep(POLL)
            new = self.next_target()
            if new and new != name:
                nxt = new
                proc.send_signal(signal.SIGINT)  # attach 收到 Ctrl-C 信号时自己还原终端；被断开的 agent 继续跑
                try:
                    proc.wait(3)
                except subprocess.TimeoutExpired:
                    proc.kill()
                    proc.wait()
        sys.stdout.write("\x1bc")  # 兜底：不管 attach 怎么结束的，整个终端复位
        sys.stdout.flush()
        self.set_showing(None)
        if nxt is None:
            code = proc.returncode
            self.note = (f"detached from {name}, it keeps running" if code == 0 else f"{name} exited" if code == 2
                         else f"attach to {name} failed (exit {code})")
        return nxt


def viewer():
    info = viewer_info()
    if info:
        sys.stderr.write(f"a viewer is already running (pid {info['pid']})\n")
        return 1
    v = Viewer()
    fd = sys.stdin.fileno()
    saved = termios.tcgetattr(fd)
    signal.signal(signal.SIGWINCH, lambda *_: setattr(v, "resized", True))
    v.set_showing(None)
    try:
        name = None
        while True:
            if name is None:
                name = v.idle()
                if name is None:
                    return 0
            termios.tcsetattr(fd, termios.TCSADRAIN, saved)  # 把终端原样交给 attach
            name = v.show(name)
            termios.tcsetattr(fd, termios.TCSADRAIN, saved)  # attach 被强行结束时没来得及还原
    except KeyboardInterrupt:
        return 0
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, saved)
        sys.stdout.write("\n")
        try:
            os.remove(channel("viewer"))
        except OSError:
            pass


# ---- 面板

def short_dir(path, home=os.path.expanduser("~")):
    """家目录写成 ~，太长只留最后两段。"""
    if not path:
        return ""
    if path == home or path.startswith(home + os.sep):
        path = "~" + path[len(home):]
    parts = path.split(os.sep)
    return path if len(parts) <= 3 else "…/" + "/".join(parts[-2:])


def align(key, text, n):
    return " " * max(0, n - width(text)) + text if key in RIGHT_ALIGNED else pad(text, n)


def fit_columns(widths, avail):
    """窄屏时按先后藏掉次要列，返回要显示的列键。行首标记占 4 格，列之间空 2 格。"""
    keys = [k for k, _, _ in PANEL_COLUMNS]
    for _, k in sorted((p, k) for k, _, p in PANEL_COLUMNS if p):
        if 4 + sum(widths[k] for k in keys) + 2 * (len(keys) - 1) <= avail:
            break
        keys.remove(k)
    return keys


def inline(s):
    """行内的 `代码` 和 **粗体**。"""
    segs = []
    for part in re.split(r"(`[^`]+`|\*\*[^*]+\*\*)", s):
        if len(part) > 2 and part[0] == part[-1] == "`":
            segs.append((part[1:-1], "code"))
        elif len(part) > 4 and part.startswith("**") and part.endswith("**"):
            segs.append((part[2:-2], "bold"))
        elif part:
            segs.append((part, None))
    return segs


def fold(segs, n, hang):
    """按显示宽度把一行样式片段折成多行，续行缩进 hang 格。"""
    lines, cur, w = [], [], 0
    for text, style in segs:
        buf = ""
        for ch in text:
            cw = width(ch)
            if w + cw > n and w > hang:
                if buf:
                    cur.append((buf, style))
                    buf = ""
                lines.append(cur)
                cur, w = ([(" " * hang, None)] if hang else []), hang
            buf += ch
            w += cw
        if buf:
            cur.append((buf, style))
    lines.append(cur)
    return lines


def md_lines(text, n):
    """把回复里常见的 Markdown 简单渲染成屏幕行，每行是 [(文字, 样式)]；表格、链接原样。"""
    out, code = [], False
    for raw in text.splitlines() or [""]:
        line = "".join(ch for ch in raw.expandtabs(4) if unicodedata.category(ch) != "Cc")
        if line.lstrip().startswith("```"):
            code = not code
            continue
        if code:
            segs, hang = [("│ ", "rule"), (line, "code")], 2
        elif m := re.match(r"#{1,6}\s+(.*)", line):
            segs, hang = [(m.group(1), "head")], 0
        elif m := re.match(r"(\s*)[-*+]\s+(.*)", line):
            lead = m.group(1) + "• "
            segs, hang = [(lead, "bullet")] + inline(m.group(2)), width(lead)
        else:
            segs, hang = inline(line), 0
        out += fold(segs, n, hang)
    return out


class Panel:
    def __init__(self, prefix, every, bell=False, stuck_start=60.0, stuck_quiet=120.0):
        self.prefix, self.every = prefix, every
        self.bell, self.stuck_start, self.stuck_quiet = bell, stuck_start, stuck_quiet
        self.records = None  # None = 还没取到
        self.selected = None  # 按名字记，列表变化时光标不跳
        self.order = []  # 表格里 agent 的显示顺序，给上下键用
        self.top = 0  # 表格滚动位置
        self.by_state = False  # 按 s 切换：按名字排 / 按状态排
        self.frame = 0  # 转圈用，按时间走
        self.reply = (None, "", False)  # (名字, 文字, 是不是提示文字而不是回复)
        self.reply_top = 0
        self.md = (None, 0, [])  # 渲染好的回复缓存：(原文, 宽度, 屏幕行)
        self.message = ""
        self.confirm = None  # 等按 y 确认要关掉的名字
        self.stopping = set()  # 从面板关掉的，消失时不再提示「已退出」
        self.prev = {}  # 名字 -> (实例, 状态, 这一轮开始的时间)，上一次刷新看到的
        self.first_seen = {}  # 名字 -> 第一次看到的时间（ls 里还在启动的项没有状态可查）
        self.new = set()  # 做完一轮、还没看过的
        self.ring = False  # 该响铃了
        self.row_at = {}  # 屏幕行号 -> 名字，给鼠标点击用
        self.reply_y = None  # 回复正文从第几行开始，给滚轮用
        self.pairs = {}  # (前景, 背景) -> curses 颜色对
        self.wake_table = threading.Event()
        self.wake_reply = threading.Event()

    # 后台线程：刷新表格、取回复、关 agent，都不卡按键

    def table_loop(self):
        while True:
            self.absorb(collect(self.prefix))
            self.wake_table.wait(self.every)
            self.wake_table.clear()

    def reply_loop(self):
        while True:
            name = self.selected
            if name:
                code, out = corral("reply", name)
                if code == 0:
                    self.reply = (name, out.get("text") or "", False)
                elif out.get("error") == "no_reply":
                    self.reply = (name, "(no reply yet)", True)
                else:
                    self.reply = (name, f"(reply failed: {out.get('error') or code})", True)
            self.wake_reply.wait(self.every)
            self.wake_reply.clear()

    def stop(self, name):
        self.stopping.add(name)
        self.message = f"stopping {name}…"
        code, out = corral("stop", name, timeout=120)
        self.message = f"stopped {name}" if code == 0 else f"stop {name} failed: {out.get('error') or code}"
        self.wake_table.set()

    def absorb(self, records):
        """记下这次刷新相对上一次的变化：做完一轮的标 ●，变成卡住或做完时按需响铃，消失的提示已退出。"""
        if any(r["name"] is None for r in records):  # corral ls 失败，不算谁退出了
            self.records = records
            return
        info = viewer_info()
        showing = info.get("showing") if info else None
        seen = {}
        for r in records:
            name, state, turn = r["name"], r["state"], r["st"].get("turn_started")
            self.first_seen.setdefault(name, time.time())
            old = self.prev.get(name)  # (实例, 状态, 这一轮开始的时间)
            if not old or old[0] != r["instance"]:
                self.new.discard(name)  # 第一次看到，或者同名重开了：不算变化
            # 做完一轮：上次在干活、这次空闲；或者两次刷新之间跑完了一整轮（这一轮开始的时间变了）
            elif state == "idle" and (old[1] == "working" or (turn and turn != old[2])):
                if name not in (self.selected, showing):
                    self.new.add(name)
                self.ring = self.ring or self.bell
            elif state == "blocked" and old[1] != "blocked":
                self.ring = self.ring or self.bell
            seen[name] = (r["instance"], state, turn)
        gone = [n for n in self.prev if n not in seen]
        exited = [n for n in gone if n not in self.stopping]
        if exited and not self.confirm:
            self.message = ", ".join(exited) + " exited"
        for n in gone:
            self.new.discard(n)
            self.first_seen.pop(n, None)
            self.stopping.discard(n)
        self.prev = seen
        self.records = records

    # 每一行显示什么

    def quiet(self, r, now):
        last = r["st"].get("last_output")
        return None if last is None else max(0.0, now - last)

    def suspect(self, r, now):
        """疑似卡住：一直在启动，或者在干活却很久没有任何输出（多半是被 Esc 打断了，Claude Code 打断时没有事件）。"""
        if r["state"] == "working":
            q = self.quiet(r, now)
            return q is not None and q >= self.stuck_quiet
        if r["state"] == "starting" or r["starting"]:
            since = r["st"].get("started") or self.first_seen.get(r["name"], now)
            return now - since >= self.stuck_start
        return False

    def marker(self, r, now):
        if r["state"] == "blocked":
            return "!"
        if self.suspect(r, now):
            return "?"
        return "●" if r["name"] in self.new else " "

    def rank(self, r, now):
        return 1 if self.suspect(r, now) else STATE_RANK.get(r["state"], 4)

    def view(self, now):
        """表格要画的行：每组一行小标题 {"group", "count"}，下面是组内的 agent {"group", "rec"}。"""
        groups = {}
        for r in self.records or []:
            name = r["name"] or ""
            groups.setdefault(name[:name.index("/") + 1] if "/" in name else "", []).append(r)
        rows = []
        for g in sorted(groups):
            rs = groups[g]
            if self.by_state:
                rs = sorted(rs, key=lambda r: (self.rank(r, now), r["name"] or ""))
            rows.append({"group": g, "count": len(rs)})
            rows += [{"group": g, "rec": r} for r in rs]
        return rows

    def cells(self, r, g, now):
        st, state = r["st"], r["state"]
        name = (r["name"] or "")[len(g):] or r["cells"][0]
        if not st:  # 启动中、不兼容、查不到：沿用 --once 那一行的说明
            return {"name": name, "kind": r["cells"][1], "instance": "", "state": r["cells"][3], "doing": "",
                    "quiet": "", "attached": "", "source": "", "dir": short_dir(r["cwd"]), "title": ""}
        doing = ""
        if state in ("working", "blocked"):
            elapsed = secs(now - st["turn_started"]) if st.get("turn_started") else ""
            doing = f"{st.get('last_tool') or 'thinking'} {elapsed}".strip()
            if state == "working":
                doing = SPIN[self.frame % len(SPIN)] + " " + doing
        return {"name": name, "kind": st.get("kind") or "", "instance": (st.get("instance") or "")[:6],
                "state": state or "", "doing": doing, "quiet": secs(self.quiet(r, now)),
                "attached": str(st.get("attached", "")), "source": st.get("last_input_source") or "",
                "dir": short_dir(r["cwd"]), "title": cut(st.get("title") or "", 28)}

    # 按键

    def names(self):
        return [r["name"] for r in self.records or [] if r["name"]]

    def select(self, name):
        self.new.discard(name)
        if name != self.selected:
            self.selected, self.reply_top = name, 0
            self.wake_reply.set()

    def move(self, step):
        names = self.order or self.names()
        if names:
            i = names.index(self.selected) if self.selected in names else 0
            self.select(names[max(0, min(len(names) - 1, i + step))])

    def show_in_viewer(self):
        name = self.selected
        if not name:
            return
        info = viewer_info()
        if not info:
            self.message = "no viewer: run tools/board --viewer in the pane next to this one"
            return
        if info.get("showing") == name:
            return
        code, st = corral("status", name)  # 现查，不用表格里几秒前的接入数
        if code == 0 and st.get("attached"):
            # 后接入的窗口只读，画面尺寸又跟着先接入的窗口走，右格会乱；干脆不接
            self.message = f"{name} is attached elsewhere, press Ctrl-] there first"
            return
        write_json(channel("target"), {"name": name, "seq": time.time_ns()})

    def handle(self, key, page):
        if self.confirm:
            name, self.confirm = self.confirm, None
            if key in (ord("y"), ord("Y")):
                threading.Thread(target=self.stop, args=(name,), daemon=True).start()
            else:
                self.message = "cancelled"
            return
        self.message = ""
        if key in (curses.KEY_UP, ord("k")):
            self.move(-1)
        elif key in (curses.KEY_DOWN, ord("j")):
            self.move(1)
        elif key in (10, 13, curses.KEY_ENTER):
            self.show_in_viewer()
        elif key == curses.KEY_MOUSE:
            try:
                _, _, y, _, button = curses.getmouse()
            except curses.error:
                return
            if button & (WHEEL_UP | WHEEL_DOWN):  # 滚轮只滚回复，不选行
                if self.reply_y is not None and y >= self.reply_y:
                    self.reply_top = max(0, self.reply_top + (-1 if button & WHEEL_UP else 1))
            elif y in self.row_at:
                self.select(self.row_at[y])
                self.show_in_viewer()
        elif key == curses.KEY_NPAGE:
            self.reply_top += page
        elif key == curses.KEY_PPAGE:
            self.reply_top = max(0, self.reply_top - page)
        elif key == ord("s"):
            self.by_state = not self.by_state
        elif key == ord("x") and self.selected:
            self.confirm = self.selected
            self.message = f"stop {self.selected}? y to confirm, any other key cancels"

    # 画：配色只用终端的标准色，背景跟随主题；256 色终端上三条横条（标题栏、回复标题、底栏）是灰底 238，选中行是深蓝底

    def color(self, fg=-1, bg=-1, extra=0):
        if not curses.has_colors():
            return extra
        if (fg, bg) not in self.pairs:
            n = len(self.pairs) + 1
            curses.init_pair(n, fg, bg)
            self.pairs[(fg, bg)] = curses.color_pair(n)
        return self.pairs[(fg, bg)] | extra

    def gray(self, bg=-1, extra=0):
        return self.color(self.gray_fg, bg, extra if self.gray_fg != -1 else extra | curses.A_DIM)

    def line(self, scr, y, segs, fill=None, box=None):
        """在第 y 行从左到右画 (文字, 属性) 片段，超宽截断；给了 fill 就用它把这一行剩下的铺满。
        给了 box（边框属性）就在两端画竖边，内容从第 1 格起、右边留一格给边框。"""
        h, w = scr.getmaxyx()
        if not 0 <= y < h:
            return
        x, right = 0, w - 1
        if box is not None:
            right = w - 2
            try:
                scr.addstr(y, 0, "│", box)
            except curses.error:
                pass
            x = 1
        for text, attr in segs:
            if x >= right:
                break
            text = cut(text, right - x)
            try:
                scr.addstr(y, x, text, attr)
            except curses.error:
                pass
            x += width(text)
        if fill is not None and x < right:
            try:
                scr.addstr(y, x, " " * (right - x), fill)
            except curses.error:
                pass
        if box is not None:
            try:
                scr.insstr(y, w - 1, "│", box)
            except curses.error:
                pass
        elif fill is not None and x < w:
            try:
                scr.insstr(y, w - 1, " ", fill)
            except curses.error:
                pass

    def rule(self, scr, y, ends, label=None):
        """框的横边：ends 是两端的角字符，label 嵌在线里（`╭─ 标签 ────╮`）。accent 给标签里要高亮的那段。"""
        box = self.gray()
        segs = [(ends[0] + "─", box)]
        used = 2
        if label:
            segs.append((" ", box))
            used += 1
            for text, attr in label:
                segs.append((text, attr))
                used += width(text)
            segs.append((" ", box))
            used += 1
        h, w = scr.getmaxyx()
        segs.append(("─" * max(0, w - 1 - used), box))
        self.line(scr, y, segs)
        try:
            scr.insstr(y, w - 1, ends[1], box)
        except curses.error:
            pass

    def row_segs(self, r, cells, keys, widths, showing, now):
        name, state = r["name"], r["state"]
        selected = name is not None and name == self.selected
        mark = self.marker(r, now)
        if selected and not curses.has_colors():
            text = " " + ("▶" if showing and name == showing else " ") + mark + " "
            text += "  ".join(align(k, cells[k], widths[k]) for k in keys)
            return [(text, curses.A_REVERSE)], curses.A_REVERSE
        fg, bg = (self.sel_fg, self.sel_bg) if selected else (-1, -1)
        base = self.color(fg, bg)
        # 选中只靠左侧色条和一层更亮的底色，行内的语义色和调暗层次照旧（8 色终端下沿用整行反白）
        dim = base if selected and not self.rich else self.color(fg, bg, curses.A_DIM)
        mark_attr = {"!": self.color(curses.COLOR_RED, bg, curses.A_BOLD),
                     "?": self.color(curses.COLOR_YELLOW, bg, curses.A_BOLD),
                     "●": self.color(curses.COLOR_CYAN, bg, curses.A_BOLD)}.get(mark, base)
        shown = showing and name == showing
        segs = [("▎" if selected else " ", self.color(self.accent_fg, bg, curses.A_BOLD) if selected else base),
                ("▶" if shown else " ", self.color(curses.COLOR_GREEN, bg) if shown else base),
                (mark, mark_attr), (" ", base)]
        elsewhere = r["attached"] - (1 if shown else 0) > 0
        q = self.quiet(r, now) if state == "working" else None
        for i, k in enumerate(keys):
            if i:
                segs.append(("  ", base))
            text = align(k, cells[k], widths[k])
            if k == "doing" and text[:1] and text[0] in SPIN:  # 转圈单独上色
                segs += [(text[:2], self.color(curses.COLOR_YELLOW, bg)), (text[2:], base)]
                continue
            if k == "name":
                attr = self.color(fg, bg, curses.A_BOLD if state == "blocked" else 0)
            elif k == "state":  # 状态前加一个色块：眼睛先落到颜色，再读字
                attr = self.state_attr(state, bg, base if selected else None)
                segs += [("● ", attr), (align(k, cells[k], widths[k] - 2), attr)]
                continue
            elif k == "attached":
                attr = self.color(curses.COLOR_MAGENTA, bg, curses.A_BOLD) if elsewhere else base
            elif k == "quiet":  # 在干活却没输出：越久越显眼；其余调暗
                attr = (self.color(curses.COLOR_RED, bg, curses.A_BOLD) if q is not None and q >= self.stuck_quiet
                        else self.color(curses.COLOR_YELLOW, bg) if q is not None and q >= 30 else dim)
            else:
                attr = dim if k in DIM_COLUMNS else base
            segs.append((text, attr))
        return segs, base

    def state_attr(self, state, bg, selected_attr=None):
        if state == "working":
            return self.color(curses.COLOR_YELLOW, bg)
        if state == "blocked":
            return self.color(curses.COLOR_RED, bg, curses.A_BOLD)
        if state == "idle":
            return self.color(curses.COLOR_GREEN, bg)
        return selected_attr or self.gray(bg)  # starting、exiting、查不到的；选中行跟着行的字色

    def style(self, name, bg=-1):
        """回复区样式对应的属性。bg 是这一块的底色，正文也要跟着铺，不然文字是透明底、和四周不一样。"""
        return {"head": self.color(curses.COLOR_CYAN, bg, curses.A_BOLD),
                "bullet": self.color(curses.COLOR_CYAN, bg),
                "code": self.color(curses.COLOR_YELLOW, bg),
                "rule": self.gray(bg), "note": self.gray(bg),
                "bold": self.color(-1, bg, curses.A_BOLD)}.get(name, self.color(-1, bg))

    def stamp(self, info):
        """屏幕内容取决于的东西。和上次画的时候一样就不用重画：时钟、秒数按秒变，转圈一秒 5 格。"""
        now = time.time()
        working = any(r["state"] == "working" for r in self.records or [])
        return (id(self.records), self.reply, self.selected, self.message, len(self.new), bool(info),
                info.get("showing") if info else None, int(now), int(now * 5) if working else 0)

    def draw(self, scr, info):
        h, w = scr.getmaxyx()
        now = time.time()
        self.frame = int(now * 5)
        records = self.records
        showing = info.get("showing") if info else None
        if showing:
            self.new.discard(showing)
        if records is not None and self.selected not in self.names():
            self.select(next(iter(self.order or self.names()), None))
        scr.erase()
        gray = self.gray()
        # 标题栏：只有产品名、警告是亮的，时钟、排序方式、「右格：」调暗；靠右，末尾留 1 格
        bar, dim_bar = self.bar, self.bar | curses.A_DIM
        left = [(" corral board", bar), (f"  {time.strftime('%H:%M:%S')}", dim_bar)]
        if self.by_state:
            left.append(("  by state", dim_bar))
        if showing or info:
            right = [("viewer: ", dim_bar), (showing or "none", bar)]
        else:
            right = [("no viewer", self.color(curses.COLOR_YELLOW, self.bar_bg, curses.A_BOLD) | self.bar_extra)]
        gap = w - 1 - sum(width(t) for t, _ in left + right)
        self.line(scr, 0, left + [(" " * max(1, gap), bar)] + right, fill=bar)
        self.row_at = {}
        # 列表和回复装在同一个圆角框里，中间用带标签的横线分节；框外只留顶栏和底栏当外壳
        edge = self.gray()
        box_fill = self.color(-1, -1)
        y = 1
        n_agents = len(records) if records else 0
        title = self.color(-1, -1, curses.A_BOLD)                 # 两条边上的标题用同一套：主词亮白加粗，细节灰
        self.rule(scr, y, "╭╮", [("agents", title)] +
                  ([(f" · {n_agents}", edge)] if records else []))
        y += 1
        if records is None:
            self.line(scr, y, [("loading…", self.gray())], fill=box_fill, box=edge)
            y += 1
        else:
            rows = self.view(now)
            for row in rows:
                if "rec" in row:
                    row["cells"] = self.cells(row["rec"], row["group"], now)
            widths = {k: max([width(head), MIN_WIDTHS.get(k, 0)] + [width(r["cells"][k]) for r in rows if "rec" in r])
                      for k, head, _ in PANEL_COLUMNS}
            keys = fit_columns(widths, w - 3)
            heads = dict((k, head) for k, head, _ in PANEL_COLUMNS)
            list_fill = box_fill
            self.line(scr, y, [("   " + "  ".join(align(k, heads[k], widths[k]) for k in keys),
                                self.gray(-1, curses.A_BOLD))], fill=list_fill, box=edge)
            y += 1
            if not records:
                self.line(scr, y, [("(no agents)", gray)], fill=list_fill, box=edge)
                y += 1
            self.order = [r["rec"]["name"] for r in rows if "rec" in r and r["rec"]["name"]]
            avail = max(1, min(max(len(rows), LIST_MIN), h - 11))  # 至少 LIST_MIN 行，上限是给回复留几行
            at = [i for i, r in enumerate(rows) if "rec" in r and r["rec"]["name"] == self.selected]
            i = at[0] if at else 0
            self.top = min(max(self.top, i - avail + 1), i, max(0, len(rows) - avail))
            for row in rows[self.top:self.top + avail]:
                if "rec" in row:
                    segs, fill = self.row_segs(row["rec"], row["cells"], keys, widths, showing, now)
                    self.line(scr, y, segs, fill=fill, box=edge)
                    if row["rec"]["name"]:
                        self.row_at[y] = row["rec"]["name"]
                else:  # 分组小标题：组名青色，数量和一条横线灰色，画到倒数第 2 格
                    label, count = row["group"] or "(no prefix)", f" ({row['count']})"
                    rest = w - 4 - (width(label) + width(count) + 1)
                    self.line(scr, y, [(label, self.color(curses.COLOR_CYAN, -1, curses.A_BOLD)),
                                       (count, self.gray()),
                                       (" " + "─" * max(0, rest), self.gray())],
                              fill=list_fill, box=edge)
                y += 1
            for _ in range(avail - len(rows[self.top:self.top + avail])):  # 行不够就留白，底色照铺
                self.line(scr, y, [], fill=list_fill, box=edge)
                y += 1
        # 回复区：框里的一条分节线隔开，标签嵌在线里；正文右边留一格给滚动条
        name, text, note = self.reply
        if self.selected:
            label = [(self.selected, title), (" · last reply", edge)]
        else:
            label = [("last reply", title)]
        self.rule(scr, y, "├┤", label)
        y += 1
        if not self.selected:
            body = [[("(no reply yet)", "note")]]
        elif name != self.selected:
            body = [[("loading…", "note")]]
        elif note:
            body = [[(text, "note")]]
        else:
            if self.md[:2] != (text, w):
                self.md = (text, w, md_lines(text, w - 4))
            body = self.md[2]
        avail = h - 2 - y                                    # 末行是底栏，倒数第 2 行是框的下边
        self.reply_y = y
        self.reply_top = max(0, min(self.reply_top, len(body) - avail))
        for segs in body[self.reply_top:self.reply_top + avail]:
            self.line(scr, y, [(t, self.style(s)) for t, s in segs], fill=box_fill, box=edge)
            y += 1
        for _ in range(max(0, avail - len(body[self.reply_top:self.reply_top + avail]))):
            self.line(scr, y, [], fill=box_fill, box=edge)
            y += 1
        if len(body) > avail > 0:  # 放不下时最右一列（边框里侧）画滚动条：░ 轨道，█ 滑块
            n = max(1, round(avail * avail / len(body)))
            top = min(avail - n, round(self.reply_top * avail / len(body)))
            for i in range(avail):
                try:
                    scr.addstr(self.reply_y + i, w - 2, "█" if top <= i < top + n else "░", gray)
                except curses.error:
                    pass
        self.rule(scr, y, "╰╯")
        y += 1
        # 底栏：按键名青色，键名后空 1 格、项间空 2 格；不足 80 列用短提示；有消息时换成消息
        if self.message:
            segs = [(" " + self.message, self.color(curses.COLOR_YELLOW, self.bar_bg, curses.A_BOLD) | self.bar_extra)]
        else:
            key = self.color(curses.COLOR_CYAN, self.bar_bg, curses.A_BOLD) | self.bar_extra
            segs = [(" ", bar)]
            for i, (k, v) in enumerate(KEYS if w >= 80 else KEYS_SHORT):
                segs += [("  " if i else "", bar), (k, key), (f" {v}", bar)]
        self.line(scr, h - 1, segs, fill=bar)
        scr.refresh()

    def run(self, scr):
        try:
            curses.curs_set(0)
        except curses.error:
            pass
        if curses.has_colors():
            curses.use_default_colors()
        rich = curses.has_colors() and curses.COLORS >= 256
        self.gray_fg = 8 if curses.has_colors() and curses.COLORS >= 16 else -1
        self.bar_bg, self.bar_extra = (238, 0) if rich else (-1, curses.A_REVERSE)  # 238 在深色底上比 236 显眼
        self.rich = rich
        self.accent_fg = 39 if rich else curses.COLOR_CYAN   # 强调色：串起「选中的行」和「它的回复」
        self.sel_fg, self.sel_bg = (-1, 237) if rich else (curses.COLOR_WHITE, curses.COLOR_BLUE)
        self.bar = self.color(7 if rich else -1, self.bar_bg) | self.bar_extra
        curses.mousemask(curses.BUTTON1_PRESSED | curses.BUTTON1_CLICKED | WHEEL_UP | WHEEL_DOWN)
        curses.mouseinterval(0)
        scr.timeout(int(POLL * 1000))
        for loop in (self.table_loop, self.reply_loop):
            threading.Thread(target=loop, daemon=True).start()
        drawn, key = None, 0
        while True:
            info = viewer_info()  # 每圈都看，右格换了人箭头马上跟上
            if key != -1 or self.stamp(info) != drawn:  # 按了键，或者屏幕上该变的变了，才重画
                self.draw(scr, info)
                drawn = self.stamp(info)
            if self.ring:
                self.ring = False
                curses.beep()
            key = scr.getch()
            if key == ord("q") and not self.confirm:
                return
            if key != -1:
                self.handle(key, max(1, scr.getmaxyx()[0] // 2))


def main():
    ap = argparse.ArgumentParser(prog="board", description="Live list of every corral agent; pick one and the pane next to it shows that agent")
    ap.add_argument("--every", type=float, default=3.0, help="refresh interval in seconds (default 3)")
    ap.add_argument("--once", action="store_true", help="print the table once and exit")
    ap.add_argument("--prefix", help="only agents whose name starts with this, e.g. demo/")
    ap.add_argument("--viewer", action="store_true", help="run as the viewer, in the pane next to the panel")
    ap.add_argument("--bell", action="store_true", help="beep when an agent finishes a turn or looks stuck")
    ap.add_argument("--stuck-start", type=float, default=60.0, help="flag as possibly stuck after this many seconds starting (default 60)")
    ap.add_argument("--stuck-quiet", type=float, default=120.0, help="flag as possibly stuck after this many seconds working with no output (default 120)")
    args = ap.parse_args()
    if args.once:
        print(render(args.prefix))
        return 0
    if args.viewer:
        return viewer()
    locale.setlocale(locale.LC_ALL, "")
    try:
        curses.wrapper(Panel(args.prefix, args.every, args.bell, args.stuck_start, args.stuck_quiet).run)
    except KeyboardInterrupt:
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
